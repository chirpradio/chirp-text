<h1>DJs</h1>
<p>CHIRP is all-volunteer. Click any DJ to see their show schedule and bio.</p>

<ul class="articles-list">
{% for dj in cms.djs %}
  <li>
    <h3><a href="/djs/{{ dj.slug or (dj.djName | slugify) }}/">{{ dj.djName }}</a></h3>
    {% if dj.showName %}<div class="meta">{{ dj.showName }}</div>{% endif %}
    {% if dj.djExcerpt %}<div class="excerpt">{{ dj.djExcerpt }}</div>{% endif %}
  </li>
{% endfor %}
</ul>
