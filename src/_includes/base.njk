<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title or 'CHIRP Radio 107.1 FM — Chicago Independent Radio' }}</title>
    <meta name="description" content="{{ description or 'CHIRP Radio is Chicago’s independent, listener-supported, all-volunteer radio station broadcasting at 107.1 FM and streaming worldwide.' }}" />
    <link rel="canonical" href="https://chirpradio.org{{ page.url }}" />
    {# Auto-refresh the homepage every 60 seconds so "now playing" stays current
       without JavaScript. Other pages stay click-to-refresh so screen-reader
       users don't lose their place while reading. #}
    {% if autoRefresh %}<meta http-equiv="refresh" content="60" />{% endif %}
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{{ title or 'CHIRP Radio' }}" />
    <meta property="og:description" content="{{ description or 'CHIRP Radio is Chicago’s independent, listener-supported, all-volunteer radio station.' }}" />
    <style>
      :root {
        --ink: #18181b;
        --paper: #fafafa;
        --red: #ea1c2c;
        --blue: #15769e;
        --muted: #4d4d56;
        --bg-soft: #f4f4f5;
        --border: #d4d4d8;
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0; padding: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, 'Roboto', system-ui, sans-serif;
        line-height: 1.5;
      }
      /* Focus rings — high-contrast on all interactive elements (WCAG 2.4.7) */
      a:focus-visible,
      button:focus-visible,
      input:focus-visible,
      summary:focus-visible {
        outline: 3px solid var(--blue);
        outline-offset: 2px;
        border-radius: 2px;
      }

      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--ink);
        color: var(--paper);
        padding: 12px 20px;
        z-index: 100;
        font-weight: 600;
      }
      .skip-link:focus {
        left: 0;
        outline: 3px solid var(--red);
        outline-offset: -3px;
      }

      /* Visually-hidden, but available to screen readers */
      .sr-only {
        position: absolute;
        width: 1px; height: 1px;
        padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0,0,0,0);
        white-space: nowrap; border: 0;
      }

      header.site {
        background: var(--ink);
        color: var(--paper);
        padding: 16px 24px;
      }
      header.site a { color: var(--paper); text-decoration: none; }
      header.site .site__brand {
        font-size: 1.25rem;
        font-weight: 800;
        margin: 0;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .site-nav {
        margin-top: 16px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px 24px;
      }
      .site-nav__group { font-size: 0.9375rem; }
      .site-nav__group-title {
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin: 0 0 6px;
        opacity: 0.7;
      }
      .site-nav ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .site-nav li { margin-bottom: 4px; }
      .site-nav a {
        display: inline-block;
        padding: 2px 0;
      }
      .site-nav a:hover,
      .site-nav a:focus { text-decoration: underline; }
      .site-nav__cta {
        font-weight: 600;
        color: #ffc8cc !important;
      }

      main { max-width: 900px; margin: 0 auto; padding: 32px 24px; }
      h2 { font-size: 1.375rem; margin: 32px 0 12px; }
      h2:first-child { margin-top: 0; }

      .now-playing {
        background: var(--bg-soft);
        border-left: 4px solid var(--red);
        padding: 16px 20px;
        border-radius: 4px;
        margin-bottom: 12px;
      }
      .now-playing strong { display: block; font-size: 1.125rem; }
      .now-playing .meta { color: var(--muted); font-size: 0.9375rem; margin-top: 4px; }

      .refresh-note {
        font-size: 0.8125rem;
        color: var(--muted);
        background: var(--bg-soft);
        padding: 8px 14px;
        border-radius: 4px;
        margin: 0 0 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
      }
      .refresh-note time {
        font-weight: 600;
        color: var(--ink);
        font-variant-numeric: tabular-nums;
      }
      .refresh-note .build-id {
        font-family: 'SF Mono', Menlo, monospace;
        font-size: 0.6875rem;
        opacity: 0.6;
      }

      .listen-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin: 16px 0;
      }
      .listen-actions a, .listen-actions button {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--blue);
        color: var(--paper);
        padding: 10px 18px;
        border-radius: 999px;
        text-decoration: none;
        border: none;
        font: inherit;
        cursor: pointer;
        font-weight: 600;
      }
      .listen-actions a:hover, .listen-actions button:hover { background: #0c557a; }
      .listen-actions a.btn-red { background: var(--red); }
      .listen-actions a.btn-red:hover { background: #b80f1f; }

      .stream-url {
        background: var(--bg-soft);
        padding: 12px 16px;
        border-radius: 4px;
        font-family: 'SF Mono', Menlo, monospace;
        font-size: 0.875rem;
        word-break: break-all;
        color: var(--ink);
        border: 1px solid var(--border);
      }

      table.playlist {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9375rem;
      }
      table.playlist th, table.playlist td {
        text-align: left;
        padding: 8px 12px;
        border-bottom: 1px solid var(--border);
      }
      table.playlist th {
        background: var(--bg-soft);
        font-weight: 600;
        font-size: 0.8125rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }
      table.playlist td.local { color: var(--red); font-weight: 600; font-size: 0.75rem; }

      .dj-list {
        list-style: none; padding: 0; margin: 0;
        column-count: 3; column-gap: 24px;
      }
      .dj-list li { break-inside: avoid; margin-bottom: 6px; font-size: 0.9375rem; }
      @media (max-width: 720px) { .dj-list { column-count: 2; } }
      @media (max-width: 480px) { .dj-list { column-count: 1; } }

      .articles-list { list-style: none; padding: 0; margin: 0; }
      .articles-list li { padding: 16px 0; border-bottom: 1px solid var(--border); }
      .articles-list h3 { margin: 0 0 4px; font-size: 1.0625rem; }
      .articles-list h3 a {
        color: var(--blue);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 2px;
      }
      .articles-list h3 a:hover { color: var(--red); }
      .articles-list .meta { color: var(--muted); font-size: 0.8125rem; }
      .articles-list .excerpt { color: var(--muted); font-size: 0.9375rem; margin-top: 6px; }

      /* Playlist hour-break header */
      .hour-block { margin-bottom: 32px; }
      .hour-header {
        background: var(--ink);
        color: var(--paper);
        padding: 10px 16px;
        margin: 0;
        font-size: 0.9375rem;
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        border-radius: 4px 4px 0 0;
      }
      .hour-header .dj-link { color: var(--paper); }
      .hour-header .time-label {
        font-family: 'SF Mono', Menlo, monospace;
        font-size: 0.8125rem;
        font-weight: 400;
        opacity: 0.9;
      }

      /* DJ profile page */
      .dj-profile h2 { margin-top: 24px; }
      .dj-meta { color: var(--muted); font-size: 0.9375rem; margin: 8px 0 16px; }

      /* Article body — preserves whatever HTML the CMS sends */
      .article-body { font-size: 1.0625rem; line-height: 1.7; }
      .article-body h2 { font-size: 1.25rem; margin-top: 24px; }
      .article-body h3 { font-size: 1.125rem; margin-top: 20px; }
      .article-body p { margin: 0 0 16px; }
      .article-body a { color: var(--blue); }
      .article-body blockquote {
        border-left: 4px solid var(--border);
        padding-left: 16px;
        margin: 16px 0;
        color: var(--muted);
        font-style: italic;
      }
      .article-body img { max-width: 100%; height: auto; }

      footer.site {
        background: var(--bg-soft);
        padding: 24px;
        margin-top: 48px;
        text-align: center;
        font-size: 0.8125rem;
        color: var(--muted);
      }
      footer.site a { color: var(--blue); }
      .build-info { font-size: 0.6875rem; opacity: 0.7; margin-top: 8px; }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to main content</a>

    <header class="site" role="banner">
      <p class="site__brand"><a href="/">CHIRP Radio · Text-only version</a></p>
      <nav aria-label="Primary" class="site-nav">
        {% for group in nav.groups %}
        <div class="site-nav__group">
          <p class="site-nav__group-title" id="nav-{{ group.title | slugify }}">{{ group.title }}</p>
          <ul aria-labelledby="nav-{{ group.title | slugify }}">
            {% for link in group.links %}
            <li><a href="{{ link.url }}">{{ link.label }}</a></li>
            {% endfor %}
            {% if group.title == 'Ways to Give' %}
            <li><a class="site-nav__cta" href="{{ cms.donateUrl }}" target="_blank" rel="noopener">Donate ↗</a></li>
            {% endif %}
          </ul>
        </div>
        {% endfor %}
      </nav>
    </header>

    <main id="content">
      {{ content | safe }}
    </main>

    <footer class="site">
      <p>
        <strong>CHIRP Radio 107.1 FM</strong> · Chicago's independent radio · chirpradio.org
      </p>
      <p class="build-info">
        Last refreshed: {{ cms.buildTime | chicagoTime }} {{ cms.buildTime | chicagoDate }}
      </p>
    </footer>
  </body>
</html>
